<Window x:Class="FM26_ScoutClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FM26 - AI LOGO DESIGNER" Height="750" Width="1050"
        Background="#0A0E17" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00FF85"/>
            <Setter Property="BorderBrush" Value="#00FF85"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A00FF85"/>
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorCircle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="1" x:Name="ellipse"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ellipse" Property="StrokeThickness" Value="2"/>
                                <Setter TargetName="ellipse" Property="Stroke" Value="#00FF85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock Text="SYSTEM TERMINAL: DATA PROTOCOL" Foreground="#00FF85" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,15"/>

            <TextBlock Text="LEAGUE SELECTION" Foreground="#444" FontSize="9" Margin="5,0,0,3" FontFamily="Consolas"/>
            <Border BorderBrush="#1A1F2B" BorderThickness="1" Background="#050505" Padding="15" Margin="0,0,0,25">
                <DockPanel>
                    <Button Content="❮" Style="{StaticResource NeonButton}" Click="PrevLeague_Click" Width="45"/>
                    <Button Content="❯" Style="{StaticResource NeonButton}" Click="NextLeague_Click" DockPanel.Dock="Right" Width="45"/>
                    <TextBlock x:Name="LeagueDisplay" Text="SELECT LEAGUE" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
                </DockPanel>
            </Border>

            <TextBlock Text="TEAM SELECTION" Foreground="#444" FontSize="9" Margin="5,0,0,3" FontFamily="Consolas"/>
            <Border BorderBrush="#1A1F2B" BorderThickness="1" Background="#050505" Padding="15">
                <DockPanel>
                    <Button Content="❮" Style="{StaticResource NeonButton}" Click="PrevTeam_Click" Width="45"/>
                    <Button Content="❯" Style="{StaticResource NeonButton}" Click="NextTeam_Click" DockPanel.Dock="Right" Width="45"/>
                    <TextBlock x:Name="TeamDisplay" Text="SELECT TEAM" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Margin="20,0,0,0" BorderBrush="#1A1F2B" BorderThickness="1,0,0,0" Padding="40,0,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LOGO DESIGNER (1:1 PNG)" Foreground="#00FF85" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,15"/>

                <Border BorderBrush="#00FF85" BorderThickness="1" Width="280" Height="280" HorizontalAlignment="Center" Background="Black">
                    <InkCanvas x:Name="LogoCanvas" Background="Transparent" Width="280" Height="280">
                        <InkCanvas.DefaultDrawingAttributes>
                            <DrawingAttributes Color="#00FF85" Width="3" Height="3" FitToCurve="True"/>
                        </InkCanvas.DefaultDrawingAttributes>
                    </InkCanvas>
                </Border>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="COLOR PALETTE" Foreground="#444" FontSize="9" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <WrapPanel HorizontalAlignment="Center">
                        <Button Background="#00FF85" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Neon Green"/>
                        <Button Background="White" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="White"/>
                        <Button Background="#FF3E3E" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Red"/>
                        <Button Background="#3E9CFF" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Blue"/>
                        <Button Background="#FFD700" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Gold"/>
                        <Button Background="#FF00E4" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Magenta"/>
                        <Button Background="#00FFFF" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Cyan"/>
                        <Button Background="#FF8C00" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Dark Orange"/>
                    </WrapPanel>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button Background="#8A2BE2" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Blue Violet"/>
                        <Button Background="#228B22" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Forest Green"/>
                        <Button Background="#DC143C" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Crimson"/>
                        <Button Background="#40E0D0" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Turquoise"/>
                        <Button Background="#FFFF00" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Yellow"/>
                        <Button Background="#707070" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Gray"/>
                        <Button Background="#C0C0C0" Style="{StaticResource ColorCircle}" Click="SetColor_Click" ToolTip="Silver"/>
                        <Button Background="Transparent" Style="{StaticResource ColorCircle}" Click="SetColor_Click" BorderBrush="Red" ToolTip="Eraser Mode (Black)" Foreground="Black"/>
                    </WrapPanel>

                    <DockPanel Margin="0,15,0,0">
                        <TextBlock Text="SIZE" Foreground="#444" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="BrushSlider" Minimum="1" Maximum="30" Value="3" ValueChanged="BrushSlider_ValueChanged" Cursor="SizeWE"/>
                    </DockPanel>
                </StackPanel>

                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="RESET CANVAS" Style="{StaticResource NeonButton}" Click="Clear_Click" Margin="0,0,5,0" Height="35"/>
                    <Button Grid.Column="1" Content="EXPORT PNG" Style="{StaticResource NeonButton}" Click="SaveLogo_Click" Margin="5,0,0,0" Height="35" Background="#00FF85" Foreground="Black" FontWeight="Black"/>
                </Grid>

                <TextBlock Text="DATA WILL BE EXPORTED TO SERVER RESOURECES" Foreground="#333" FontSize="8" Margin="0,15,0,0" HorizontalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>